modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[artifacts]]
id = "artifacts/cascade-8"

[[artifacts]]
id = "artifacts/api-server"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "atk", "cups", "dbus", "expat", "fontconfig", "freetype", "glib", "gtk3", "libdrm", "libxkbcommon", "mesa", "nss", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[userenv]

[userenv.shared]
USE_SUPABASE_DATABASE = "true"

[userenv.development]
ROULETTE_ROUND_GENERATION_PAUSED = "false"
